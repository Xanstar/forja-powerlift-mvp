# Application
APP_NAME=Forja

# Local admin created by `pnpm db:seed`
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding

# Use file:./sqlite.db locally. Turso deployments also require TURSO_AUTH_TOKEN.
DATABASE_URL=file:./sqlite.db
TURSO_AUTH_TOKEN=

# Replace with a random value before starting or building the application.
AUTH_SECRET=replace-with-a-random-secret

# URL pública de Forja y proveedor de WhatsApp (Evolution API)
APP_URL=http://localhost:3000
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=replace-with-evolution-api-key
EVOLUTION_INSTANCE_NAME=forja

# Compatibilidad temporal. Cambiar a false cuando todos los atletas estén activados.
ATHLETE_LEGACY_PIN_ENABLED=false
ATHLETE_TRUST_PROXY_HEADERS=false
ATHLETE_DEMO_ACCESS_TOKEN=
