# Application
APP_NAME=Forja

# Local admin created by `pnpm db:seed`
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding

# Use file:./sqlite.db locally. Turso deployments also require TURSO_AUTH_TOKEN.
DATABASE_URL=file:./sqlite.db
TURSO_AUTH_TOKEN=

# Replace with a random value before starting or building the application.
AUTH_SECRET=replace-with-a-random-secret
