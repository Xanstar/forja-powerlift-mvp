{
  "name": "powerlift-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.1.1 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test:auth": "node --import tsx --test tests/authorization.test.ts tests/athlete-access-foundation.test.ts tests/athlete-access-integration.test.ts",
    "test:onboarding": "node --import tsx --test tests/athlete-onboarding.test.ts tests/evolution-client.test.ts",
    "test:execution": "node --import tsx --test tests/execution.test.ts tests/execution-db.test.ts tests/day-completion-migration.test.ts tests/day-completion-operation.test.ts tests/day-completion.test.ts tests/offline-queue.test.ts tests/program-operations.test.ts",
    "test:corrections": "node --import tsx --test tests/corrections.test.ts",
    "test:access": "node --import tsx --test tests/access-request.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "start": "next start",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
